# Supabase Project Settings → Data API / API Settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Secret server key. Never prefix this variable with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Created by supabase/setup.sql. Keep this value unless you create another public bucket.
SUPABASE_STORAGE_BUCKET=site-media

# At least 8 characters.
ADMIN_PASSWORD=

# Recommended: a separate long random value used to sign the admin session cookie.
ADMIN_SESSION_SECRET=
